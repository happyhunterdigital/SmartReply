# SmartReply worker - Cloud Run service.
# Long-lived BullMQ consumer: sends DMs, runs the polling reconciler, and does
# follow-gate checks. It has no public API; worker/dm-worker.ts exposes a tiny
# /healthz endpoint on $PORT (8080) so Cloud Run keeps the instance healthy.
#
# Build (uses this Dockerfile, which is not the default filename):
#   gcloud builds submit --config cloudbuild.worker.yaml .
# Deploy (after the image is built):
#   gcloud run deploy smartreply-worker \
#     --image gcr.io/<PROJECT_ID>/smartreply-worker \
#     --region <REGION> \
#     --no-allow-unauthenticated \
#     --min-instances 1 \
#     --no-cpu-throttling \
#     --cpu 1 \
#     --memory 1Gi \
#     --set-env-vars REDIS_URL=...,DATABASE_URL=...,NEXTAUTH_URL=https://smartreply.happyhunterdigital.com \
#     --set-secrets ENCRYPTION_KEY=smartreply-encryption-key:latest
#
# `--no-cpu-throttling` keeps CPU allocated outside requests; without it the
# queue consumer stalls. `--min-instances 1` keeps the instance up permanently.
# ENCRYPTION_KEY must be byte-for-byte identical to the web app's value.
FROM node:22-slim AS base
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev=false

COPY prisma ./prisma
COPY tsconfig.json ./
COPY worker ./worker
COPY lib ./lib
COPY types ./types

RUN npm run db:generate

# Cloud Run default port, used by the health endpoint in worker/dm-worker.ts.
ENV PORT=8080
EXPOSE 8080

CMD ["npm", "run", "worker"]
